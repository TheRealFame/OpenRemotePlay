{
  "name": "open-remote-play",
  "version": "2.0.0",
  "description": "OpenRemotePlay (ORP) v2 — Universal serverless WebRTC remote play protocol. MIT License.",
  "main": "server.js",
  "bin": {
    "orp-daemon": "bin/orp-daemon.mjs"
  },
  "scripts": {
    "start": "node server.js",
    "daemon": "node bin/orp-daemon.mjs",
    "build": "cd packages/orp-client && npm run build",
    "test": "node test/smoke.test.mjs && node test/schemas.test.mjs && node test/conformance.test.mjs && node test/daemon.test.mjs",
    "test:smoke": "node test/smoke.test.mjs",
    "test:schemas": "node test/schemas.test.mjs",
    "test:conformance": "node test/conformance.test.mjs",
    "test:daemon": "node test/daemon.test.mjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.18.0"
  },
  "keywords": [
    "webrtc",
    "remote-play",
    "streaming",
    "open-standard",
    "orp",
    "p2p",
    "serverless"
  ],
  "author": "OpenRemotePlay Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheRealFame/OpenRemotePlay.git"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
