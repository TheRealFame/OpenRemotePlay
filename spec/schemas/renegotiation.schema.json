{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openremoteplay.org/schemas/v2/renegotiation.schema.json",
  "title": "ORP In-Session Renegotiation Event",
  "description": "Dynamic in-session reconfiguration for controller connection/disconnection and media parameters (ORP_SPEC §6)",
  "type": "object",
  "required": ["type", "action"],
  "properties": {
    "type": {
      "type": "string",
      "const": "renegotiate"
    },
    "action": {
      "type": "string",
      "enum": [
        "controller-attach",
        "controller-detach",
        "media-reconfigure",
        "keyframe-request",
        "input-mode-change"
      ],
      "description": "Specific renegotiation event"
    },
    "padIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Affected controller slot index"
    },
    "controllerType": {
      "type": "string",
      "enum": ["gamepad", "kbm", "dualshock", "xboxone", "wheel", "flightstick"],
      "description": "Client hardware or emulated controller classification"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "bitrate": {
      "type": "integer",
      "minimum": 100000
    }
  },
  "additionalProperties": false
}
